@echo off
REM Release environment for Windows
REM This file is evaluated by the release boot script.

REM ── Data directory ─────────────────────────────────────────────────
if not defined DUST_DATA_DIR set DUST_DATA_DIR=%LOCALAPPDATA%\Dust
if not exist "%DUST_DATA_DIR%" mkdir "%DUST_DATA_DIR%"

REM ── Node identity ──────────────────────────────────────────────────
REM The node's host portion is the unique name picked at `dustctl init`.
REM The daemon writes it to %DUST_DATA_DIR%\node_name. Falls back to "dust".
if not defined RELEASE_NODE (
  set _DUST_NODE_NAME=dust
  if exist "%DUST_DATA_DIR%\node_name" (
    for /f "usebackq tokens=1 delims=" %%n in ("%DUST_DATA_DIR%\node_name") do set _DUST_NODE_NAME=%%n
  )
  set RELEASE_NODE=dust@!_DUST_NODE_NAME!
  set _DUST_NODE_NAME=
)
if not defined RELEASE_COOKIE set RELEASE_COOKIE=dust_cookie

REM Distribution runs in SHORT-name mode, and must stay that way. Node
REM atoms are `dust@<name>` with a dotless host on purpose — peers route
REM by name through Dust.Bridge.EPMD. Under long names, dotless hosts
REM that aren't literal IPs are rejected during connection setup.
if not defined RELEASE_DISTRIBUTION set RELEASE_DISTRIBUTION=sname
