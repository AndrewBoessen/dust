#!/bin/sh
# Release environment for Unix (Linux / macOS)
# This file is evaluated by the release boot script.

# ── Data directory ───────────────────────────────────────────────────
export DUST_DATA_DIR="${DUST_DATA_DIR:-$HOME/.dust}"
mkdir -p "$DUST_DATA_DIR"

# ── Node identity ────────────────────────────────────────────────────
# The node's host portion (the part after `@`) is the unique name picked
# at `dustctl init` — peers route to each other by name through the
# Tailscale sidecar's EPMD module, not by IP. The daemon writes the
# chosen name to $DUST_DATA_DIR/node_name; this script reads it before
# the VM starts. Falls back to "dust" if missing.
if [ -z "$RELEASE_NODE" ]; then
  _dust_node_name=""
  if [ -r "$DUST_DATA_DIR/node_name" ]; then
    _dust_node_name=$(head -n 1 "$DUST_DATA_DIR/node_name" | tr -d '[:space:]')
  fi
  if [ -z "$_dust_node_name" ]; then
    _dust_node_name="dust"
  fi
  export RELEASE_NODE="dust@${_dust_node_name}"
  unset _dust_node_name
fi
export RELEASE_COOKIE="${RELEASE_COOKIE:-dust_cookie}"

# Distribution runs in SHORT-name mode, and must stay that way. Node
# atoms are `dust@<name>` with a dotless host on purpose — peers route
# by name through Dust.Bridge.EPMD, not by DNS or IP. Under long names
# (`name`), inet_tcp_dist:splitnode/3 rejects any dotless host that
# isn't a literal IP, so every Node.connect/1 to a peer dies with
# "** Hostname <name> is illegal **" — after the bridge has already
# resolved and proxied it, which makes the failure look unrelated.
export RELEASE_DISTRIBUTION="${RELEASE_DISTRIBUTION:-sname}"

# ── VM tuning ────────────────────────────────────────────────────────
# Let the BEAM use all available schedulers
export ERL_MAX_PORTS="${ERL_MAX_PORTS:-65536}"
