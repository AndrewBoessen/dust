<div class="min-h-full">
  <header class="border-b border-zinc-200 bg-white">
    <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-3">
      <div class="flex items-center gap-6">
        <.link navigate={~p"/"} class="text-lg font-semibold tracking-tight">
          Dust
        </.link>
        <nav class="flex items-center gap-4 text-sm text-zinc-600">
          <.link navigate={~p"/files"} class="hover:text-zinc-900">Files</.link>
          <.link navigate={~p"/peers"} class="hover:text-zinc-900">Peers</.link>
          <.link navigate={~p"/storage"} class="hover:text-zinc-900">Storage</.link>
        </nav>
      </div>
      <.link
        href={~p"/logout"}
        method="delete"
        class="text-sm text-zinc-500 hover:text-zinc-900"
      >
        Lock
      </.link>
    </div>
  </header>

  <.flash_group flash={@flash} />

  <main class="mx-auto max-w-6xl px-6 py-8">
    {@inner_content}
  </main>
</div>
