<div class="flex min-h-screen items-center justify-center px-6 py-12">
  <div class="w-full max-w-sm space-y-6">
    <div class="text-center">
      <h1 class="text-2xl font-bold tracking-tight">Dust</h1>
      <p class="mt-1 text-sm text-zinc-500">Unlock your node to continue.</p>
    </div>

    <%= if @system_ready? do %>
      <.form
        for={%{}}
        as={:session}
        action={~p"/login"}
        method="post"
        class="space-y-4"
      >
        <.input
          name="password"
          id="password"
          type="password"
          label="Keystore password"
          required
          autocomplete="current-password"
          placeholder="••••••••"
        />

        <p :if={@error} class="text-sm text-rose-600">{@error}</p>

        <.button type="submit" class="w-full">Unlock</.button>
      </.form>
    <% else %>
      <div class="rounded-md border border-zinc-200 bg-white p-4 text-center text-sm text-zinc-600">
        <p class="font-medium text-zinc-900">Daemon is still starting…</p>
        <p class="mt-1">
          Waiting for the network to be ready. This page will reload shortly.
        </p>
        <meta http-equiv="refresh" content="2" />
      </div>
    <% end %>
  </div>
</div>
